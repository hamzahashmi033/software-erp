# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/payment_link?schema=public"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="changeme"
AUTH_COOKIE_SECRET="a-very-long-random-string-at-least-32-chars"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"

# Your billing notification email (receives payment alerts)
BILLING_EMAIL="billing@yourcompany.com"

# Sender identity shown to clients
FROM_EMAIL="invoices@yourcompany.com"
FROM_NAME="Leen Design Studios"
