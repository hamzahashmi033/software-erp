# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/payment_link?schema=public"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Show fake demo invoices in the Dashboard/Invoices views instead of real data
USE_FAKE_INVOICE_DATA="false"

# ── Auth ──────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD="changeme"
AUTH_COOKIE_SECRET="a-very-long-random-string-at-least-32-chars"

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST="mail.yourcompany.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="billing@yourcompany.com"
SMTP_PASS="your-smtp-password"

# Your billing notification email (receives payment alerts)
BILLING_EMAIL="billing@yourcompany.com"

# Sender identity shown to clients
FROM_EMAIL="billing@yourcompany.com"
FROM_NAME="Your Company Name"
